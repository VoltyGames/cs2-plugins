# Shared by every inventory server with `secrets: elect-host`.
# CI: store this file's contents in the prod-elect-host environment's SERVER_ENV secret.

# The panel account: SFTP logs in as <SFTP_USER>.<server id>.
SFTP_USER=suxrobgm
SFTP_PASSWORD=

# Optional, for `poe rcon`: when every server uses the same RCON password.
RCON_PASSWORD=
