{
  "plugin": {
    // Server default language: a file name in translations/ without `.json`. A player's
    // pick in the main menu's Settings tab wins over it.
    "locale": "ru"
  },
  "server": {
    // Stable unique identity used by per-server grants.
    "tag": "default",
    // Display name registered in the servers table.
    "name": "CS2 Server"
  },
  "database": {
    "driver": "postgres",
    "host": "localhost",
    "port": 5432,
    "database": "admin_system",
    "username": "postgres",
    "password": "Test12345#",
    // PostgreSQL modes: "disable" | "allow" | "prefer" | "require" | "verify-ca" | "verify-full".
    // MariaDB enables TLS for "require" and verify modes; SQLite ignores this setting.
    "sslMode": "prefer",
    "connectTimeoutSec": 5
    // SQLite example:
    // "driver": "sqlite",
    // "path": "addons/voltmod/plugins/admin-system/data/admin-system.sqlite"
  },
  "punishments": {
    // Used when an admin omits a ban reason.
    "defaultBanReason": "Banned by administrator",
    // Warnings before escalation triggers.
    "warningThreshold": 3,
    // Quick Punish presets. Invalid entries are skipped after logging.
    // Durations: "perm"/"0" or <n>s / <n>m / <n>h / <n>d; bare numbers are seconds.
    "templates": [
      {
        "name": "Cheating",
        "type": "ban",
        "duration": "perm",
        "reason": "Cheating"
      },
      {
        "name": "Griefing",
        "type": "ban",
        "duration": "1d",
        "reason": "Team damage / griefing"
      },
      {
        "name": "Mic spam",
        "type": "voiceMute",
        "duration": "30m",
        "reason": "Mic spam"
      },
      {
        "name": "Toxic voice",
        "type": "voiceMute",
        "duration": "2h",
        "reason": "Toxic behavior in voice"
      },
      {
        "name": "Chat spam",
        "type": "textMute",
        "duration": "30m",
        "reason": "Chat spam"
      },
      {
        "name": "Toxic chat",
        "type": "textMute",
        "duration": "2h",
        "reason": "Toxic behavior in chat"
      }
    ],
    // Reasons offered by manual punishment flows; the menu also includes `Custom...`.
    "reasonPresets": [
      "Cheating",
      "Toxic behavior",
      "Mic spam",
      "Team damage / griefing",
      "Inappropriate nickname"
    ],
    // Duration-picker rows using the template duration grammar.
    "menuDurations": ["5m", "30m", "1h", "1d", "7d", "perm"]
  },
  "abuseProtection": {
    // Automatic freezing only; manual freeze commands remain available.
    "enabled": true,
    // Network-wide sliding window in minutes.
    "windowMinutes": 10,
    // Reaching a threshold freezes the admin; 0 disables it. Root ("*") admins are exempt.
    "maxBans": 5,
    "maxKicks": 10,
    // Combined voice and text mutes.
    "maxMutes": 15,
    "maxWarnings": 15
  },
  "chat": {
    "broadcastPunishments": true,
    "tagAdminChatMessages": true,
    // Used without a group prefix. `fallbackNameColor` and `fallbackMessageColor` also default to "default".
    "fallbackPrefix": "[ADMIN]",
    "fallbackPrefixColor": "red"
  },
  "reports": {
    // Enables `!r` and `!report` for all players.
    "enabled": true,
    // Seconds between reports from one player; 0 disables the limit.
    "cooldownSec": 120,
    // Seconds before the same reporter can report the same target again; 0 disables the limit.
    "duplicateWindowSec": 1800,
    // Adds a 64-character `Other...` reason stored with code `other`.
    "allowCustomReason": true,
    // `code` is the website key; `label` is the fallback for a missing translation.
    "reasons": [
      { "code": "cheating", "label": "Cheating / aimbot" },
      { "code": "wallhack", "label": "Wallhack" },
      { "code": "griefing", "label": "Griefing / team damage" },
      { "code": "abuse", "label": "Toxic behavior" },
      { "code": "micspam", "label": "Mic spam" },
      { "code": "nickname", "label": "Inappropriate nickname" }
    ]
  },
  "cheatCheck": {
    // Delivery mode: "fixedLink" | "websiteAutoRoom" | "playerProvided".
    "mode": "fixedLink",
    // Seconds to comply before the timeout action fires.
    "timeoutSec": 120,
    // False unfreezes and notifies the admin instead of kicking.
    "autoKick": true,
    "kickReason": "Failed to comply with cheat check",
    // Ban on timeout, with `kickReason` as the reason. `banDurationSec` 0 is permanent.
    "autoBan": true,
    "banDurationSec": 0,
    // Move the suspect to spectator as well as freezing them.
    "moveToSpectator": true,
    // Optional HTTPS panel image; empty disables it. `bannerWidth` and `bannerHeight` default to 320x180.
    "bannerImageUrl": "",
    // Suspect URL for "fixedLink" and fallback for "websiteAutoRoom".
    "fixedLink": {
      "url": "https://discord.gg/your-invite"
    },
    // Defaults for meat-app. Other APIs also need "authHeader", "authScheme", "playerUrlField",
    // "checkerUrlField", and "presenceField"; see the schema.
    "websiteAutoRoom": {
      "createRoomUrl": "http://localhost:4000/api/rooms",
      // meat-app keys start with mk_ and need JOIN_ROOM_AS_ADMIN permission.
      "apiKey": "",
      // String values may use {steamId}, {playerName}, {adminSteamId} and {adminName}.
      "requestBody": {
        "purpose": "CHEAT_CHECK",
        "title": "Cheat check: {playerName}",
        "isLocked": false,
        // Lets the backend assign the calling admin as host.
        "adminSteamId": "{adminSteamId}",
        "metadata": {
          "reason": "Suspect {playerName} ({steamId}) - by {adminName}"
        }
      },
      // Shown to the suspect and relayed to the admin; {value} is the room code.
      "playerUrlTemplate": "http://localhost:4001/rooms/{value}",
      "checkerUrlTemplate": "http://localhost:4001/rooms/{value}",
      // Polled participant list; the countdown pauses while the suspect is in it. Empty disables
      // it; placeholders are {code} and {steamId}.
      "presenceUrl": "http://localhost:4000/api/rooms/{code}/participants",
      // Poll cadence and maximum delay before detecting a join.
      "pollIntervalSec": 5
    }
  },
  "maps": {
    // Admin map list; the engine exposes none. A nonzero `workshopId` selects a published-file ID.
    // Omitting `cycle` uses these defaults, so the Map menu remains available.
    "cycle": [
      { "name": "de_dust2", "displayName": "Dust II" },
      { "name": "de_mirage", "displayName": "Mirage" },
      { "name": "de_inferno", "displayName": "Inferno" },
      { "name": "de_nuke", "displayName": "Nuke" },
      { "name": "de_ancient", "displayName": "Ancient" },
      { "name": "de_anubis", "displayName": "Anubis" }
    ],
    "vote": {
      // Share of the ballots cast that must be yes.
      "successRatio": 0.6,
      // How long the panel stays open.
      "durationSec": 20
    }
  },
  // The workshop addon every connecting client must download (the admin menu layout among it); 0 requires none.
  "addonId": 0,
  "menu": {
    // Use Panorama instead of center HTML. `uv run poe panorama` installs admin_menu locally.
    "panorama": false
  },
  "weapons": {
    // Offered by Player Actions > Give weapon. `item` is an entity classname; non-`weapon_` values are skipped.
    // Omitting `menu` uses these defaults.
    "menu": [
      { "name": "AK-47", "item": "weapon_ak47" },
      { "name": "M4A4", "item": "weapon_m4a1" },
      { "name": "AWP", "item": "weapon_awp" },
      { "name": "Desert Eagle", "item": "weapon_deagle" },
      { "name": "R8 Revolver", "item": "weapon_revolver" },
      { "name": "MP9", "item": "weapon_mp9" },
      { "name": "Nova", "item": "weapon_nova" },
      { "name": "Negev", "item": "weapon_negev" },
      { "name": "Knife", "item": "weapon_knife" },
      { "name": "HE Grenade", "item": "weapon_hegrenade" },
      { "name": "Flashbang", "item": "weapon_flashbang" },
      { "name": "Smoke", "item": "weapon_smokegrenade" },
      { "name": "Molotov", "item": "weapon_molotov" }
    ]
  }
}
