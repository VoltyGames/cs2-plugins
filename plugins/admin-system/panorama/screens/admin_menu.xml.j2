{% extends "screen.xml.j2" %}
{% import "menu.xml.j2" as blocks %}
{% import "hero.xml.j2" as hero %}
{% from "admin_menu/icons.j2" import ICONS %}

{#- Shown on the home page in place of the rows. -#}
{% set home %}
{{ hero.hero("{s:brand}") }}
<Panel class="stats">
  <Panel class="stat">
    <Label class="overline stat__label" text="{s:home_players_label}" />
    <Label class="stat__value" text="{s:home_players}" />
  </Panel>
  <Panel class="stat stat--last">
    <Label class="overline stat__label" text="{s:home_map_label}" />
    <Label class="stat__value" text="{s:home_map}" />
  </Panel>
</Panel>
{% endset %}

{% block content %}
  {% call blocks.menu(6, 8, ICONS, home) -%}
  <Label class="menu__brand-title" text="{s:brand}" />
  <Label class="menu__brand-subtitle" text="{s:brand_subtitle}" />
  {%- endcall %}
{% endblock %}
